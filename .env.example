# Operating Mode: automatic | supervised
OPERATIONAL_MODE=automatic

# Poll Interval in minutes (1-5)
POLL_INTERVAL_MINUTES=2

# AI Provider: ollama | huggingface | mock | gemini | openai
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Optional API keys for cloud providers if AI_PROVIDER is set to gemini or openai
GEMINI_API_KEY=
OPENAI_API_KEY=

# Email Provider: mock | gmail | imap
EMAIL_PROVIDER=mock

# Gmail Settings (Used if EMAIL_PROVIDER=gmail)
GMAIL_CREDENTIALS_FILE=config/credentials.json
GMAIL_TOKEN_FILE=config/token.json

# IMAP / SMTP Settings (Used if EMAIL_PROVIDER=imap)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Company & Signature Config
COMPANY_NAME=Empresa ABC
AGENT_NAME=Asistente Virtual IA
AGENT_ROLE=Gestor de Atención al Cliente
COMPANY_PHONE=+57 300 123 4567
COMPANY_HOURS=Lunes a Viernes de 8:00 AM a 5:00 PM
COMPANY_WEBSITE=https://empresaabc.com
REPLY_SIGNATURE=Atentamente,\nGestión Automática - Empresa ABC

# Confidence & Safety Thresholds (%)
AUTO_REPLY_CONFIDENCE_THRESHOLD=95.0
HUMAN_REVIEW_CONFIDENCE_THRESHOLD=85.0

# Database
DATABASE_URL=sqlite+aiosqlite:///./database/email_agent.db
